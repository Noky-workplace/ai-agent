# Multi-step chains: python3 -m evals.run_evals --chains
# Each step scores the model's first action; non-final steps carry the scripted
# tool result fed back to the model. No tool is ever executed.
{"id": "c01", "category": "search_fetch", "prompt": "Look up what Python 3.14 changed about free-threading and read the official What's New page before answering.", "steps": [{"expect": ["web_search"], "result": "Results for 'python 3.14 free-threading':\n1. What's New In Python 3.14 — https://docs.python.org/3/whatsnew/3.14.html — Free-threaded Python is now officially supported (PEP 779)...\n2. Python 3.14 free threading benchmarks — https://example-blog.dev/py314-nogil — We measured...\n3. Reddit: is 3.14 nogil ready? — https://www.reddit.com/r/Python/comments/abc123 — discussion"}, {"expect": ["fetch_url"], "check": {"equals": {"url": "https://docs.python.org/3/whatsnew/3.14.html"}}, "result": "What's New In Python 3.14\n\nFree-threaded Python is officially supported. PEP 779 moves the free-threaded build from experimental to supported (phase II). The single-threaded performance penalty is now roughly 5-10%..."}, {"expect": ["none"]}]}
{"id": "c02", "category": "search_fetch", "prompt": "Find the official Ollama blog post announcing structured outputs and summarise it.", "steps": [{"expect": ["web_search"], "result": "Results for 'ollama structured outputs announcement':\n1. Structured outputs · Ollama Blog — https://ollama.com/blog/structured-outputs — Ollama now supports structured outputs, making it possible to constrain a model's output to a JSON schema...\n2. Hacker News discussion — https://news.ycombinator.com/item?id=42346344 — comments\n3. Medium: trying Ollama JSON mode — https://medium.com/@someone/ollama-json-mode-1234 — tutorial"}, {"expect": ["fetch_url"], "check": {"equals": {"url": "https://ollama.com/blog/structured-outputs"}}, "result": "Structured outputs\n\nOllama now supports structured outputs, making it possible to constrain a model's output to a specific format defined by a JSON schema. Use cases: parsing data from documents, extracting data from images..."}, {"expect": ["none"]}]}
{"id": "c03", "category": "search_fetch", "prompt": "What did the HKEX announce about its new trading hours? Check the actual announcement, not just headlines.", "steps": [{"expect": ["web_search"], "result": "Results for 'HKEX trading hours announcement':\n1. HKEX News Release: Changes to Trading Hours — https://www.hkex.com.hk/News/News-Release/2026/260301news — HKEX today announced...\n2. SCMP: Hong Kong bourse to extend trading — https://www.scmp.com/business/markets/article/3301234 — The stock exchange plans...\n3. Bloomberg: HK exchange hours — https://www.bloomberg.com/news/articles/2026-03-01/hk-hours — paywalled"}, {"expect": ["fetch_url"], "check": {"contains": {"url": "hkex.com.hk"}}, "result": "HKEX News Release\n\nHKEX announced that the securities market morning session will start at 9:00 am from the third quarter, subject to market readiness..."}, {"expect": ["none"]}]}
{"id": "c04", "category": "prices_python", "prompt": "Get Tencent's (0700.HK) daily prices for 2024 and compute its total return over the year.", "steps": [{"expect": ["get_prices"], "result": "Saved 246 1d bars of 0700.HK, 2024-01-02 to 2024-12-31.\nFirst close 296.00, last close 415.00 (+40.2% over the period), range 260.20–482.00.\nFile: sandbox_io/data/0700.HK_1d_2024-01-01_2024-12-31.csv\nIn run_python, open it as 'data/0700.HK_1d_2024-01-01_2024-12-31.csv' (run_python's working directory is sandbox_io). Columns: date, open, high, low, close, adj_close, volume.\nSource: Yahoo Finance via yfinance (unofficial; may have gaps or adjustment errors — fine for research, not for trading)."}, {"expect": ["run_python"], "check": {"contains": {"code": "data/0700.HK_1d_2024-01-01_2024-12-31.csv"}}, "result": "stdout:\ntotal return (adj_close): 43.1%"}, {"expect": ["none"]}]}
{"id": "c05", "category": "prices_python", "prompt": "Download Hang Seng Index (^HSI) daily data for 2023 and calculate its maximum drawdown.", "steps": [{"expect": ["get_prices"], "result": "Saved 244 1d bars of ^HSI, 2023-01-03 to 2023-12-29.\nFirst close 20145.29, last close 17047.39 (-15.4% over the period), range 16201.49–22688.90.\nFile: sandbox_io/data/HSI.idx_1d_2023-01-01_2023-12-31.csv\nIn run_python, open it as 'data/HSI.idx_1d_2023-01-01_2023-12-31.csv' (run_python's working directory is sandbox_io). Columns: date, open, high, low, close, adj_close, volume.\nSource: Yahoo Finance via yfinance (unofficial; may have gaps or adjustment errors — fine for research, not for trading)."}, {"expect": ["run_python"], "check": {"contains": {"code": "data/HSI.idx_1d_2023-01-01_2023-12-31.csv"}}, "result": "stdout:\nmax drawdown: -28.6% (peak 2023-01-27, trough 2023-12-28)"}, {"expect": ["none"]}]}
{"id": "c06", "category": "prices_python", "prompt": "Fetch AAPL daily prices from 2025-01-01 to 2025-06-30 and tell me on how many days the close was above its 50-day moving average.", "steps": [{"expect": ["get_prices"], "result": "Saved 124 1d bars of AAPL, 2025-01-02 to 2025-06-30.\nFirst close 243.85, last close 205.17 (-15.9% over the period), range 172.42–247.10.\nFile: sandbox_io/data/AAPL_1d_2025-01-01_2025-06-30.csv\nIn run_python, open it as 'data/AAPL_1d_2025-01-01_2025-06-30.csv' (run_python's working directory is sandbox_io). Columns: date, open, high, low, close, adj_close, volume.\nSource: Yahoo Finance via yfinance (unofficial; may have gaps or adjustment errors — fine for research, not for trading)."}, {"expect": ["run_python"], "check": {"contains": {"code": "data/AAPL_1d_2025-01-01_2025-06-30.csv"}}, "result": "stdout:\ndays above 50-day SMA: 31 of 75"}, {"expect": ["none"]}]}
{"id": "c07", "category": "read_edit", "prompt": "In config.toml, change the server port from 8080 to 9090.", "steps": [{"expect": ["read_file"], "check": {"contains": {"path": "config.toml"}}, "result": "Contents of config.toml:\n[server]\nhost = \"127.0.0.1\"\nport = 8080\nworkers = 2\n\n[log]\nlevel = \"info\"\n"}, {"expect": ["edit_file"], "check": {"within": {"old_string": "[server]\nhost = \"127.0.0.1\"\nport = 8080\nworkers = 2\n\n[log]\nlevel = \"info\"\n"}, "contains": {"old_string": "8080", "new_string": "9090"}}, "result": "Replaced 1 of 1 occurrence(s) in config.toml (verified)."}, {"expect": ["none"]}]}
{"id": "c08", "category": "read_edit", "prompt": "Fix the typo 'recieve' in notes/todo.md.", "steps": [{"expect": ["read_file"], "check": {"contains": {"path": "todo.md"}}, "result": "Contents of notes/todo.md:\n# Todo\n\n- recieve the TA schedule from the department\n- finish backtest write-up\n"}, {"expect": ["edit_file"], "check": {"within": {"old_string": "# Todo\n\n- recieve the TA schedule from the department\n- finish backtest write-up\n"}, "contains": {"old_string": "recieve", "new_string": "receive"}}, "result": "Replaced 1 of 1 occurrence(s) in notes/todo.md (verified)."}, {"expect": ["none"]}]}
{"id": "c09", "category": "notes_read", "prompt": "What did I write in my notes about eigenvalues? Show me the full note.", "steps": [{"expect": ["search_notes"], "result": "Matches for 'eigenvalues':\n  notes/linear-algebra.md:3: Eigenvalues: det(A - λI) = 0; trace = sum of eigenvalues\n  notes/linear-algebra.md:7: Symmetric matrices have real eigenvalues"}, {"expect": ["read_file"], "check": {"contains": {"path": "linear-algebra.md"}}, "result": "Contents of notes/linear-algebra.md:\n# Linear algebra\n\nEigenvalues: det(A - λI) = 0; trace = sum of eigenvalues\nDeterminant = product of eigenvalues\n\nSpectral theorem\nSymmetric matrices have real eigenvalues and orthogonal eigenvectors.\n"}, {"expect": ["none"]}]}
{"id": "c10", "category": "notes_read", "prompt": "Open my note on the SMA crossover backtest and remind me what the Sharpe ratio was.", "steps": [{"expect": ["search_notes", "list_files"], "result": "Matches for 'sma crossover':\n  notes/backtest-0700hk-sma-crossover.md:1: # backtest 0700.HK sma crossover\n  notes/backtest-0700hk-sma-crossover.md:9: Sharpe 0.84 vs buy-and-hold 0.61"}, {"expect": ["read_file"], "check": {"contains": {"path": "backtest-0700hk-sma-crossover.md"}}, "result": "Contents of notes/backtest-0700hk-sma-crossover.md:\n# backtest 0700.HK sma crossover\n\n20/50 SMA crossover, 2019-2024, 0.1% per side.\nTotal return 61%, CAGR 8.3%, max drawdown -38%.\nSharpe 0.84 vs buy-and-hold 0.61. 23 trades.\n"}, {"expect": ["none"]}]}
{"id": "c11", "category": "refused_retry", "prompt": "Use Python to compute the 30th Fibonacci number.", "steps": [{"expect": ["run_python"], "result": "DENIED: the user declined to run this code. Do not retry the same code. Explain your reasoning in text instead, or propose different code and ask again."}, {"expect": ["none", "run_python"], "check": {"forbid_repeat": true}}]}
{"id": "c12", "category": "refused_retry", "prompt": "Run Python to list the files in sandbox_io with their sizes.", "steps": [{"expect": ["run_python"], "result": "DENIED: the user declined to run this code. Do not retry the same code. Explain your reasoning in text instead, or propose different code and ask again."}, {"expect": ["none", "run_python", "list_files"], "check": {"forbid_repeat": true}}]}
{"id": "c13", "category": "edit_retry", "prompt": "In app.py, make the tax function use a rate of 0.15 instead of 0.1.", "history": [{"call": {"name": "read_file", "arguments": {"path": "app.py"}}, "result": "Contents of app.py:\ndef tax(items):\n    return sum(i.price for i in items) * 0.1\n\n\ndef tip(items):\n    return sum(i.price for i in items) * 0.1\n"}, {"call": {"name": "edit_file", "arguments": {"path": "app.py", "old_string": "    return sum(i.price for i in items) * 0.1", "new_string": "    return sum(i.price for i in items) * 0.15"}}, "result": "Error: old_string appears 2 times in app.py. Include more surrounding lines to make it unique, or set replace_all=true."}], "steps": [{"expect": ["edit_file", "read_file"], "check": {"forbid_repeat": true}, "result": "Replaced 1 of 1 occurrence(s) in app.py (verified).", "check_by_tool": {"edit_file": {"contains": {"old_string": "def tax"}, "forbid": {"replace_all": true}}}}, {"expect": ["none"]}]}

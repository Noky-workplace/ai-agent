    {
      "id": "m04",
      "category": "math",
      "prompt": "What is the standard deviation of 3, 7, 7, 19, 24?",
      "expect": [
        "run_python"
      ],
      "answers": [
        {
          "got": "run_python",
          "args": {
            "code": "import math\n\n# Given data\nnumbers = [3, 7, 7, 19, 24]\n\n# Calculate the mean\nmean = sum(numbers) / len(numbers)\n\n# Calculate the squared differences from the mean\nsquared_diffs = [(x - mean)**2 for x in numbers]\n\n# Calculate the variance (population variance)\nvariance = sum(squared_diffs) / len(numbers)\n\n# Calculate the standard deviation\nstandard_deviation = math.sqrt(variance)\n\nstandard_deviation"
          },
          "arg_problems": [],
